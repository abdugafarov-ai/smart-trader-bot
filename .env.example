# Smart Trader Bot - Environment Configuration
# Скопируйте этот файл в .env и заполните значения

# Telegram Bot Token (получи у @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ID администратора бота (только он одобряет заявки)
# Узнай свой ID: отправь /start боту @userinfobot
ADMIN_ID=YOUR_TELEGRAM_ID_HERE

# Биржа для крипто-данных
EXCHANGE=binance

# Часовой пояс пользователя
TIMEZONE=Asia/Tashkent

# Таймфрейм по умолчанию (Intraday M15 setup: H1 context -> M15 POI -> M5 trigger)
DEFAULT_TIMEFRAME=M15

# Торговые пары по умолчанию (Строго XAUUSD Intraday)
DEFAULT_SYMBOLS=XAUUSD

# ID пользователей для авто-уведомлений (через запятую)
NOTIFY_USER_IDS=YOUR_TELEGRAM_ID_HERE

# Интервал авто-сканирования в минутах (M5/M15 цикл)
SCAN_INTERVAL_MINUTES=5

# Безопасные дефолты авто-торговли (MT5 Execution Bridge)
AUTOTRADE_ENABLED=false
AUTOTRADE_DEFAULT_RISK=0.25
AUTOTRADE_MAX_RISK=0.50
AUTOTRADE_DEFAULT_LOT=0.01
BRIDGE_API_KEY=CHANGE_ME_TO_STRONG_RANDOM_SECRET
WINE_MT5_PATH=/home/trader/.wine/drive_c/Program Files/MetaTrader 5

# Еженедельный отчёт (суббота в 10:00)
WEEKLY_REPORT_DAY=5
WEEKLY_REPORT_HOUR=10

# Данные торгового счёта (заполняются в защищённом .env)
CHALLENGE_ACCOUNT=YOUR_MT5_ACCOUNT_NUMBER_HERE
CHALLENGE_BROKER=FundingPips

